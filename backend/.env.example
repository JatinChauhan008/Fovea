# Copy to backend/.env and fill in. Every value below has a working default
# except SARVAM_API_KEY - without it, AI features fall back to local generation.

# --- security ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=20160

# --- storage ---
DATABASE_URL=sqlite:///./fovea.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=40

# --- reading defaults ---
DEFAULT_WPM=250
MIN_WPM=100
MAX_WPM=900

# --- Sarvam AI (summaries + comprehension quizzes) ---
# Without a key, summaries use extractive ranking and quizzes use the local
# cloze generator. Both paths are labelled "heuristic" in the API response.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT_SECONDS=90

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
