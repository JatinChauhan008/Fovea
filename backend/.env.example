# Copy to backend/.env and adjust. Every value below has a working default.

# --- security ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=20160

# --- storage ---
DATABASE_URL=sqlite:///./fovea.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=40

# --- reading defaults ---
DEFAULT_WPM=250
MIN_WPM=100
MAX_WPM=900

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
