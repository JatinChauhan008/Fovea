# Copy to backend/.env and adjust. Every value below has a working default.

# --- environment ---
# Set to "development" to suppress JWT_SECRET safety checks locally.
# Never set this in production.
FOVEA_ENV=development

# --- security ---
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the default value unless FOVEA_ENV=development.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=20160

# --- storage ---
DATABASE_URL=sqlite:///./fovea.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=40

# --- reading defaults ---
DEFAULT_WPM=250
MIN_WPM=100
MAX_WPM=900

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
